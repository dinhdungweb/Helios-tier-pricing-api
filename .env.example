# Shopify Store Configuration
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CURRENCY=VND
SHOPIFY_COUNTRY=VN
REQUIRE_APP_PROXY=false
ALLOWED_ORIGINS=https://helios.vn,https://www.helios.vn,https://your-store.myshopify.com

# Legacy endpoint/fallback only. Secure checkout reads the published theme.
TIER_CONFIG_JSON=[{"name":"BLACK DIAMOND","tag":"BLACK DIAMOND","discount":10,"threshold":100000000},{"name":"DIAMOND","tag":"DIAMOND","discount":8,"threshold":20000000},{"name":"PLATINUM","tag":"PLATINUM","discount":6,"threshold":10000000},{"name":"GOLD","tag":"GOLD","discount":4,"threshold":6000000},{"name":"SILVER","tag":"SILVER","discount":2,"threshold":3000000},{"name":"MEMBER","tag":"","discount":0,"threshold":0}]
# SHOPIFY_ACCESS_TOKEN must include the read_themes scope.
# Secure checkout reads settings_data.json + settings_schema.json from MAIN.
# A changed theme updatedAt invalidates this cache on the next checkout.
THEME_POLICY_CACHE_TTL_MS=60000
TIER_PRIORITIZE_TAGS=true
TIER_PRICING_SCOPE=all
TIER_PRICING_PRODUCT_TAGS=
TIER_PRICING_COLLECTION_HANDLES=

# Free gifts are server-controlled and disabled unless explicitly configured.
FREE_GIFT_ENABLED=false
FREE_GIFT_VARIANT_IDS=
FREE_GIFT_TRIGGER_COLLECTION=all-products
FREE_GIFT_MINIMUMS_JSON={"VND":2000000}

CARD_FLIP_HISTORY_DELETE_PASSWORD=change-this-password

# Notes:
# 1. Copy this file to .env for local development
# 2. Get SHOPIFY_ACCESS_TOKEN from Shopify Admin → Apps → Custom App
# 3. Required API scopes include: read_themes, write_draft_orders, read_products, read_customers
# 4. Keep REQUIRE_APP_PROXY=false until the Shopify proxy and API secret are configured
# 5. For Vercel deployment, set these as environment variables in Vercel dashboard

